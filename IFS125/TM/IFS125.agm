ModuleDef IFS125 [ Panel= IFSCStat_w=11 ] {
  IFS125 Bruker Spectrometer
  Panel is used to specify which panel to use in the tabbed MATLAB interface
  IFSCStat_w defines how wide to make the IFSCStat field
}

mode (default) {
  tmcbase = IFSCStat.tmc:
  tmcbase = IFS125.tmc
  cmdbase = IFS.cmd
  cmdbase = IFSscan.cmd:
  extbase = IFSDiag.tmc
  genuibase = IFS125.genui:IFS125.genui.in
  infoext : info.tmc infoext.oui
  - : IFS125.tbl:IFS125.tbl.in
  - : Config/IFSUAconfig.pm:IFSUAconfig.pm.tmpl
  DISTRIB = @MODDIR@/../IFSctrl
  DISTRIB = @MODDIR@/../IFSmsg.pm
  DISTRIB = @MODDIR@/../IFSq.pm
  DISTRIB = @MODDIR@/../IFSretr.pm
  DISTRIB = @MODDIR@/../IFStm.pm
  DISTRIB = @MODDIR@/../ColSend.pm
  DISTRIB = @MODDIR@/../mClient.pm
  DISTRIB = @MODDIR@/../IFSUserAgent.pm
  DISTRIB = Config/IFSUAconfig.pm
  DISTRIB = Config/IFSopts.pm
  SRCDIST = IFSCStat.labels
  CPPFLAGS = -I @MODDIR@
  IGNORE = IFSUAconfig.pm
  OBJ = IFS125.genui IFS125.tbl
  OBJ = IFSCStat.tmc IFSCStat.labels IFSscan.cmd
  %%
IFSscan.cmd : @MODDIR@/../IFSctrl Config/IFSopts.pm
	if TMBINDIR=Config PERL5LIB=@MODDIR@/.. @MODDIR@/../IFSctrl cmdgen >IFSscan.cmd; then true; else rm IFSscan.cmd; false; fi
IFSCStat.tmc : @MODDIR@/../IFSctrl Config/IFSopts.pm
	if TMBINDIR=Config PERL5LIB=@MODDIR@/.. @MODDIR@/../IFSctrl display @IFSCStat_w@ >IFSCStat.tmc; then true; else rm IFSCStat.tmc; false; fi
IFSCStat.labels : @MODDIR@/../IFSctrl Config/IFSopts.pm
	if TMBINDIR=Config PERL5LIB=@MODDIR@/.. @MODDIR@/../IFSctrl labels @IFSCStat_w@ >IFSCStat.labels; then true; else rm IFSCStat.labels; false; fi
IFSsrvr.o : resistors.h
resistors.h : Config/slice-ipp.in
	@rm -f resistors.h
	cd Config && slice-ipp
	@rm -f Config/slice-ipp.stat
	mv Config/resistors.h resistors.h

}
